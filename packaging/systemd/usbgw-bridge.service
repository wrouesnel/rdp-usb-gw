[Unit]
Description=USB redirection bridge for RDP sessions
Before=gnome-headless-session@.service

[Service]
ExecStartPre=/usr/sbin/modprobe vhci-hcd
ExecStart=/usr/bin/usbgw-bridge
# Root writes vhci_hcd's sysfs attach file. The group opens the socket to the
# desktop user's gnome-remote-desktop, and to nobody else.
Group=usbgw
RuntimeDirectory=usbgw
RuntimeDirectoryMode=0750
Restart=on-failure

[Install]
WantedBy=multi-user.target
