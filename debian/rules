#!/usr/bin/make -f
export DH_VERBOSE = 1
export PATH := /usr/lib/rust-1.97/bin:$(PATH)
export CARGO_HOME := $(CURDIR)/debian/cargo-home
export CARGO_TARGET_DIR := $(CURDIR)/target

%:
	dh $@

override_dh_auto_configure:
	mkdir -p $(CARGO_HOME)
	printf '%s\n' \
	  '[source.crates-io]' 'replace-with = "vendored-sources"' \
	  '[source."git+https://github.com/Devolutions/IronRDP?rev=da016ce"]' \
	  'git = "https://github.com/Devolutions/IronRDP"' 'rev = "da016ce"' \
	  'replace-with = "vendored-sources"' \
	  '[source.vendored-sources]' 'directory = "$(CURDIR)/vendor"' \
	  > $(CARGO_HOME)/config.toml

override_dh_auto_build:
	cargo build --release --offline --frozen

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --release --offline --frozen
endif

override_dh_auto_install:
	install -D -m 0755 target/release/rdp-usb-gw debian/rdp-usb-gw/usr/bin/rdp-usb-gw
	install -D -m 0644 data/70-rdp-usb-gw.rules debian/rdp-usb-gw/usr/lib/udev/rules.d/70-rdp-usb-gw.rules
	install -D -m 0644 data/rdp-usb-gw.modules-load debian/rdp-usb-gw/usr/lib/modules-load.d/rdp-usb-gw.conf
	install -D -m 0644 data/rdp-usb-gw.service debian/rdp-usb-gw/usr/lib/systemd/system/rdp-usb-gw.service
	install -D -m 0644 data/rdp-usb-gw.sysusers debian/rdp-usb-gw/usr/lib/sysusers.d/rdp-usb-gw.conf

override_dh_auto_clean:
	rm -rf target debian/cargo-home

# dh_clean deletes *.orig files, and the vendored crates' checksums cover
# their Cargo.toml.orig.
override_dh_clean:
	dh_clean -XCargo.toml.orig
